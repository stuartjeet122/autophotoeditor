<ui:FluentWindow
    x:Class="AutoPhotoEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="AutoPhotoEditor"
    Width="1500"
    Height="920"
    MinWidth="1100"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="#F5F6F8">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- COLORS                                                    -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="WindowBackground" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#181A1F"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#777D87"/>
        <SolidColorBrush x:Key="MutedText" Color="#A0A5AE"/>
        <SolidColorBrush x:Key="WorkspaceBackground" Color="#101216"/>

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>


        <!-- ========================================================= -->
        <!-- CLEAN BUTTON                                               -->
        <!-- ========================================================= -->

        <Style
            x:Key="CleanButton"
            TargetType="Button">

            <Setter
                Property="Background"
                Value="Transparent"/>

            <Setter
                Property="BorderThickness"
                Value="0"/>

            <Setter
                Property="Foreground"
                Value="{StaticResource SecondaryText}"/>

            <Setter
                Property="Padding"
                Value="10,7"/>

            <Setter
                Property="Cursor"
                Value="Hand"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="#EEF0F3"/>

                    <Setter
                        Property="Foreground"
                        Value="#202329"/>

                </Trigger>

                <Trigger
                    Property="IsPressed"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="#E3E6EA"/>

                </Trigger>

                <Trigger
                    Property="IsEnabled"
                    Value="False">

                    <Setter
                        Property="Opacity"
                        Value="0.4"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- CARD                                                       -->
        <!-- ========================================================= -->

        <Style
            x:Key="Card"
            TargetType="Border">

            <Setter
                Property="Background"
                Value="{StaticResource PanelBackground}"/>

            <Setter
                Property="BorderBrush"
                Value="{StaticResource BorderColor}"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="CornerRadius"
                Value="16"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- ROOT                                                          -->
    <!-- ============================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER                                                      -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#E7E9ED"
            BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- APP BRAND -->

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border
                        Width="40"
                        Height="40"
                        CornerRadius="12"
                        Background="#181A1F">

                        <TextBlock
                            Text="A"
                            FontSize="19"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="AutoPhotoEditor"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#181A1F"/>

                        <TextBlock
                            Margin="0,2,0,0"
                            Text="Professional photo enhancement"
                            FontSize="11"
                            Foreground="#9297A0"/>

                    </StackPanel>

                </StackPanel>


                <!-- CURRENT IMAGE -->

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="PHOTO EDITOR"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="#A2A7B0"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Margin="0,3,0,0"
                        Text="{Binding OriginalImagePath,
                                       TargetNullValue='No image selected'}"
                        MaxWidth="500"
                        TextTrimming="CharacterEllipsis"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#383C43"
                        HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- HEADER ACTIONS -->

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        Style="{StaticResource CleanButton}"
                        Command="{Binding UndoCommand}"
                        Width="38"
                        Height="38"
                        Margin="0,0,3,0"
                        ToolTip="Undo">

                        <TextBlock
                            Text="↶"
                            FontSize="21"/>

                    </Button>

                    <Button
                        Style="{StaticResource CleanButton}"
                        Command="{Binding RedoCommand}"
                        Width="38"
                        Height="38"
                        Margin="0,0,12,0"
                        ToolTip="Redo">

                        <TextBlock
                            Text="↷"
                            FontSize="21"/>

                    </Button>

                    <ui:Button
                        Command="{Binding ChooseImageCommand}"
                        Appearance="Primary"
                        Content="Open Image"
                        Padding="20,10"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN                                                        -->
        <!-- ========================================================= -->

        <Grid
            Grid.Row="1"
            Margin="20,18,20,14">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- PHOTO WORKSPACE                                       -->
            <!-- ===================================================== -->

            <Border
                Grid.Column="0"
                Margin="0,0,16,0"
                CornerRadius="18"
                Background="#101216"
                BorderBrush="#24272D"
                BorderThickness="1"
                Padding="10">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>
                        <RowDefinition Height="88"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- IMAGE AREA                                        -->
                    <!-- ================================================= -->

                    <Border
                        Grid.Row="0"
                        Background="#0D0F13"
                        CornerRadius="12"
                        ClipToBounds="True">

                        <Grid
                            x:Name="PhotoComparisonArea"
                            Background="#0D0F13"
                            ClipToBounds="True">


                            <!-- ================================================= -->
                            <!-- ACTUAL IMAGE HOST                                -->
                            <!-- ================================================= -->

                            <Grid
                                x:Name="ImageHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">


                                <!-- BEFORE -->

                                <Image
                                    x:Name="BeforeImageControl"
                                    Source="{Binding OriginalImage}"
                                    Stretch="Fill"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>


                                <!-- AFTER CLIPPING -->

                                <Grid
                                    x:Name="AfterImageClip"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    ClipToBounds="True">

                                    <Image
                                        x:Name="AfterImageControl"
                                        Source="{Binding EditedImage}"
                                        Stretch="Fill"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                </Grid>


                                <!-- ================================================= -->
                                <!-- BEFORE LABEL                                    -->
                                <!-- ================================================= -->

                                <Border
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="18"
                                    Padding="11,6"
                                    Background="#B5000000"
                                    CornerRadius="7"
                                    IsHitTestVisible="False">

                                    <TextBlock
                                        Text="BEFORE"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="White"/>

                                </Border>


                                <!-- AFTER LABEL -->

                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="18"
                                    Padding="11,6"
                                    Background="#B5000000"
                                    CornerRadius="7"
                                    IsHitTestVisible="False">

                                    <TextBlock
                                        Text="AFTER"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="White"/>

                                </Border>


                                <!-- ================================================= -->
                                <!-- COMPARISON DIVIDER                              -->
                                <!-- ================================================= -->

                                <Border
                                    x:Name="ComparisonDivider"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="White"
                                    IsHitTestVisible="False">

                                    <Border.Effect>

                                        <DropShadowEffect
                                            BlurRadius="12"
                                            ShadowDepth="0"
                                            Opacity="0.55"/>

                                    </Border.Effect>

                                </Border>


                                <!-- ================================================= -->
                                <!-- COMPARISON HANDLE                               -->
                                <!-- ================================================= -->

                                <Border
                                    x:Name="ComparisonHandle"
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    CornerRadius="22"
                                    IsHitTestVisible="False">

                                    <Border.Effect>

                                        <DropShadowEffect
                                            BlurRadius="16"
                                            ShadowDepth="2"
                                            Opacity="0.35"/>

                                    </Border.Effect>

                                    <Grid>

                                        <TextBlock
                                            Text="‹  ›"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Foreground="#30343A"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- EMPTY STATE                                       -->
                            <!-- ================================================= -->

                            <Grid
                                x:Name="EmptyState"
                                Background="#101216">

                                <Grid.Style>

                                    <Style TargetType="Grid">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding OriginalImage}"
                                                Value="{x:Null}">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Grid.Style>


                                <StackPanel
                                    Width="340"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <Border
                                        Width="72"
                                        Height="72"
                                        CornerRadius="20"
                                        Background="#191C22"
                                        HorizontalAlignment="Center">

                                        <TextBlock
                                            Text="＋"
                                            FontSize="36"
                                            Foreground="#858B96"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock
                                        Margin="0,20,0,0"
                                        Text="Choose an image"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="#F3F4F6"
                                        HorizontalAlignment="Center"/>

                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Text="Open a photo to start enhancing."
                                        FontSize="12"
                                        Foreground="#818792"
                                        HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- PROCESSING OVERLAY                                -->
                            <!-- ================================================= -->

                            <Grid
                                Background="#70000000"
                                Visibility="{Binding IsBusy,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Border
                                    Width="280"
                                    Padding="24"
                                    CornerRadius="16"
                                    Background="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <StackPanel>

                                        <ProgressBar
                                            Height="4"
                                            IsIndeterminate="True"/>

                                        <TextBlock
                                            Margin="0,15,0,0"
                                            Text="Processing image..."
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#202329"
                                            HorizontalAlignment="Center"/>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Text="{Binding StatusMessage}"
                                            FontSize="11"
                                            Foreground="#858B94"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- ===================================================== -->
                    <!-- COMPARISON CONTROL                                   -->
                    <!-- ===================================================== -->

                    <Grid
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Width="{Binding ElementName=ImageHost,
                                         Path=ActualWidth}"
                        Margin="0,5,0,0">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- LABELS -->

                        <Grid
                            Grid.Row="0">

                            <TextBlock
                                Text="BEFORE"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#747A84"
                                HorizontalAlignment="Left"/>

                            <TextBlock
                                Text="AFTER"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#747A84"
                                HorizontalAlignment="Right"/>

                        </Grid>


                        <!-- FULL IMAGE WIDTH SLIDER -->

                        <Slider
                            x:Name="ComparisonSlider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="100"
                            Height="24"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Value="{Binding ComparisonPosition,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                            ValueChanged="ComparisonSlider_ValueChanged"/>


                        <!-- QUICK BUTTONS -->

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0">

                            <Button
                                Style="{StaticResource CleanButton}"
                                Command="{Binding ShowBeforeCommand}"
                                Content="Before"
                                FontSize="11"/>

                            <Button
                                Style="{StaticResource CleanButton}"
                                Command="{Binding ResetComparisonCommand}"
                                Content="50 / 50"
                                FontSize="11"/>

                            <Button
                                Style="{StaticResource CleanButton}"
                                Command="{Binding ShowAfterCommand}"
                                Content="After"
                                FontSize="11"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- RIGHT SIDEBAR                                              -->
            <!-- ========================================================= -->

            <Border
                Grid.Column="1"
                Style="{StaticResource Card}"
                Padding="18">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- HEADER -->

                    <StackPanel Grid.Row="0">

                        <TextBlock
                            Text="Edit"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock
                            Margin="0,5,0,0"
                            Text="Enhance your photo with intelligent tools."
                            FontSize="12"
                            Foreground="{StaticResource SecondaryText}"
                            TextWrapping="Wrap"/>

                    </StackPanel>


                    <!-- AUTO ENHANCE -->

                    <Border
                        Grid.Row="1"
                        Margin="0,22,0,0"
                        Padding="16"
                        Background="#F4F5F7"
                        CornerRadius="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <Grid Grid.Row="0">

                                <StackPanel>

                                    <TextBlock
                                        Text="Auto Enhance"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#1D2025"/>

                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Text="Natural adaptive correction"
                                        FontSize="11"
                                        Foreground="#858B94"/>

                                </StackPanel>

                                <Border
                                    HorizontalAlignment="Right"
                                    Padding="7,3"
                                    CornerRadius="5"
                                    Background="#E5E7EB">

                                    <TextBlock
                                        Text="AI"
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Foreground="#636973"/>

                                </Border>

                            </Grid>


                            <TextBlock
                                Grid.Row="1"
                                Margin="0,13,0,12"
                                Text="Balance exposure, colour, contrast and detail automatically."
                                FontSize="11"
                                Foreground="#737983"
                                TextWrapping="Wrap"/>


                            <ui:Button
                                Grid.Row="2"
                                Command="{Binding AutoEnhanceCommand}"
                                Appearance="Primary"
                                Content="Auto Enhance"
                                Height="40"
                                HorizontalContentAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- MASKED AUTO ENHANCE -->

                    <Border
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="#FFFFFF"
                        BorderBrush="#E7E9ED"
                        BorderThickness="1"
                        CornerRadius="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Text="Mask Auto Enhance"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#1D2025"/>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,3,0,12"
                                Text="Enhance detected regions and reuse their masks on the original photo."
                                FontSize="11"
                                Foreground="#858B94"
                                TextWrapping="Wrap"/>

                            <ui:Button
                                Grid.Row="2"
                                Command="{Binding MaskedEnhanceCommand}"
                                Appearance="Secondary"
                                Content="Enhance Mask Auto"
                                Height="38"
                                HorizontalContentAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- COLOR GRADE -->

                    <Border
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="#FFFFFF"
                        BorderBrush="#E7E9ED"
                        BorderThickness="1"
                        CornerRadius="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <TextBlock
                                Grid.Row="0"
                                Text="Color Grade"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#1D2025"/>


                            <TextBlock
                                Grid.Row="1"
                                Margin="0,3,0,12"
                                Text="Apply a creative photographic look."
                                FontSize="11"
                                Foreground="#858B94"/>


                            <ComboBox
                                Grid.Row="2"
                                Height="38"
                                Padding="9,0"
                                ItemsSource="{Binding LUTs}"
                                SelectedItem="{Binding SelectedLut,
                                                       Mode=TwoWay}"
                                DisplayMemberPath="Name"/>


                            <ui:Button
                                Grid.Row="3"
                                Margin="0,10,0,0"
                                Command="{Binding ColorGradeCommand}"
                                Appearance="Secondary"
                                Content="Apply Color Grade"
                                Height="38"
                                HorizontalContentAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- WORKFLOW -->

                    <ScrollViewer
                        Grid.Row="4"
                        Margin="0,18,0,0"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock
                                Text="Workflow"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#747A84"/>


                            <Border
                                Margin="0,9,0,0"
                                Padding="13"
                                Background="#F7F8FA"
                                CornerRadius="12">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel>

                                        <TextBlock
                                            Text="Edit history"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="#30343A"/>

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Text="Undo or redo changes"
                                            FontSize="11"
                                            Foreground="#8A9099"/>

                                    </StackPanel>


                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal">

                                        <Button
                                            Style="{StaticResource CleanButton}"
                                            Command="{Binding UndoCommand}"
                                            Content="Undo"
                                            FontSize="11"/>

                                        <Button
                                            Style="{StaticResource CleanButton}"
                                            Command="{Binding RedoCommand}"
                                            Content="Redo"
                                            FontSize="11"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>


                    <!-- STATUS / EXPORT -->

                    <StackPanel
                        Grid.Row="4"
                        Margin="0,15,0,0">

                        <Border
                            Padding="10"
                            Margin="0,0,0,10"
                            Background="#F6F7F9"
                            CornerRadius="9">

                            <Grid>

                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="#65B77C"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Margin="14,0,0,0"
                                    Text="{Binding StatusMessage}"
                                    FontSize="11"
                                    Foreground="#777D87"
                                    TextTrimming="CharacterEllipsis"/>

                            </Grid>

                        </Border>


                        <ui:Button
                            Command="{Binding SaveImageCommand}"
                            Appearance="Primary"
                            Content="Export Image"
                            Height="44"
                            HorizontalContentAlignment="Center"/>


                        <Button
                            Style="{StaticResource CleanButton}"
                            Command="{Binding CancelProcessingCommand}"
                            Content="Cancel Processing"
                            Height="34"
                            Margin="0,4,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- FOOTER                                                      -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#E7E9ED"
            BorderThickness="0,1,0,0">

            <Grid Margin="24,0">

                <TextBlock
                    Text="AutoPhotoEditor"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#9A9FA8"/>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Preview"
                        Margin="0,0,8,0"
                        FontSize="11"
                        Foreground="#9A9FA8"
                        VerticalAlignment="Center"/>

                    <CheckBox
                        IsChecked="{Binding IsPreviewMode,
                                            Mode=TwoWay}"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</ui:FluentWindow>
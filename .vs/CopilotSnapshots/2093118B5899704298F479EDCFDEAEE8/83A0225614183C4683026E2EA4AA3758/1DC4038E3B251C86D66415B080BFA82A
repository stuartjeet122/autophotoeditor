    public async Task<MaskDataResult> MaskDataAsync(
        byte[] imageBytes,
        string jobId,
        Action<ApiJobEvent>? progress = null,
        CancellationToken cancellationToken = default,
        string device = "auto")
    {
        ValidateImageBytes(imageBytes);

        ValidateDevice(device);

        string url =
            "/mask-data?job_id=" +
            Uri.EscapeDataString(jobId) +
            "&device=" +
            Uri.EscapeDataString(device);

        Task<string> requestTask =
            _http.PostBytesAsync(
                url,
                imageBytes,
                "application/octet-stream",
                cancellationToken);

        string response =
            await WaitForOperationAsync(
                jobId,
                progress,
                requestTask,
                cancellationToken);

        try
        {
            using JsonDocument document =
                JsonDocument.Parse(response);

            JsonElement artifactData =
                document.RootElement
                    .GetProperty("artifact")
                    .GetProperty("data")
                    .GetProperty("data");

            if (artifactData.ValueKind != JsonValueKind.Object)
            {
                throw new AutoPhotoEditorApiException(
                    "The API did not return valid mask JSON.");
            }

            var maskNames = new List<string>();

            if (document.RootElement.TryGetProperty(
                    "masks",
                    out JsonElement masks) &&
                masks.ValueKind == JsonValueKind.Object)
            {
                foreach (JsonProperty mask in masks.EnumerateObject())
                {
                    maskNames.Add(mask.Name);
                }
            }

            return new MaskDataResult
            {
                JobId = jobId,
                MaskJson = artifactData.Clone(),
                MaskNames = maskNames
            };
        }
        catch (KeyNotFoundException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API response does not contain mask JSON.",
                ex);
        }
        catch (JsonException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API returned invalid mask JSON.",
                ex);
        }
    }

    public async Task<AutoEnhanceApiResult> MaskedEnhanceAsync(
        byte[] imageBytes,
        JsonElement maskJson,
        double strength = 1.0,
        double feather = 2.0,
        IReadOnlyCollection<string>? maskNames = null,
        string? jobId = null,
        Action<ApiJobEvent>? progress = null,
        CancellationToken cancellationToken = default)
    {
        ValidateImageBytes(imageBytes);

        if (maskJson.ValueKind is JsonValueKind.Undefined or JsonValueKind.Null)
        {
            throw new ArgumentException(
                "Mask JSON is required.",
                nameof(maskJson));
        }

        jobId ??= CreateJobId();

        var request = new
        {
            image_base64 = Convert.ToBase64String(imageBytes),
            mask_json = maskJson
        };

        string url =
            "/masked-adaptive-enhance-json?strength=" +
            Uri.EscapeDataString(strength.ToString(CultureInfo.InvariantCulture)) +
            "&feather=" +
            Uri.EscapeDataString(feather.ToString(CultureInfo.InvariantCulture)) +
            "&job_id=" +
            Uri.EscapeDataString(jobId);

        if (maskNames != null)
        {
            foreach (string maskName in maskNames)
            {
                if (string.IsNullOrWhiteSpace(maskName))
                    continue;

                url +=
                    "&masks=" +
                    Uri.EscapeDataString(maskName.Trim());
            }
        }

        Task<string> requestTask =
            _http.PostJsonAsync(
                url,
                request,
                cancellationToken);

        string response =
            await WaitForOperationAsync(
                jobId,
                progress,
                requestTask,
                cancellationToken);

        try
        {
            using JsonDocument document =
                JsonDocument.Parse(response);

            string? base64 =
                document.RootElement
                    .GetProperty("artifact")
                    .GetProperty("data")
                    .GetString();

            if (string.IsNullOrWhiteSpace(base64))
            {
                throw new AutoPhotoEditorApiException(
                    "The API returned an empty masked enhancement.");
            }

            return new AutoEnhanceApiResult
            {
                JobId = jobId,
                ImageBytes = Convert.FromBase64String(base64)
            };
        }
        catch (KeyNotFoundException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API response does not contain an enhanced image.",
                ex);
        }
        catch (JsonException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API returned invalid masked enhancement JSON.",
                ex);
        }
        catch (FormatException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API returned invalid image data.",
                ex);
        }
    }


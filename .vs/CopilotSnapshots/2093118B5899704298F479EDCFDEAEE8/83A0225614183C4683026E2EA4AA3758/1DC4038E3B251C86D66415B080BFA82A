    public async Task<ApiJobStatus> GetJobStatusAsync(
        string jobId,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(jobId))
        {
            throw new ArgumentException(
                "Job ID cannot be empty.",
                nameof(jobId));
        }


        string url =
            "/jobs/" +
            Uri.EscapeDataString(jobId);


        string json =
            await _http.GetAsync(
                url,
                cancellationToken);


        ApiJobStatus result;

        try
        {
            result =
                JsonSerializer.Deserialize<ApiJobStatus>(
                    json,
                    JsonOptions)
                ?? throw new AutoPhotoEditorApiException(
                    "The API returned an empty job status.");
        }
        catch (JsonException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API returned invalid job status JSON.",
                ex);
        }

        result.JobId =
            jobId;

        if (result.Latest != null)
        {
            result.Status = result.Latest.Type;
            result.Stage = result.Latest.Stage;
            result.Message = result.Latest.Message;
            result.Progress = result.Latest.EffectiveProgress;
        }

        return result;
    }

    public async Task CancelJobAsync(
        string jobId,
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(jobId))
        {
            throw new ArgumentException(
                "Job ID cannot be empty.",
                nameof(jobId));
        }

        string url =
            "/jobs/" +
            Uri.EscapeDataString(jobId) +
            "/cancel";

        await _http.PostJsonAsync(
            url,
            new { },
            cancellationToken);
    }


    // ========================================================================
    // JOB POLLING
    // ========================================================================

    private async Task<string> WaitForOperationAsync(
        string jobId,
        Action<ApiJobEvent>? progress,
        Task<string> operationTask,
        CancellationToken cancellationToken)
    {
        Task pollingTask =
            PollJobUntilFinishedAsync(
                jobId,
                progress,
                operationTask,
                cancellationToken);

        try
        {
            return await operationTask;
        }
        finally
        {
            try
            {
                await pollingTask;
            }
            catch (OperationCanceledException)
            {
                // Normal cancellation.
            }
        }
    }

    private async Task PollJobUntilFinishedAsync(
        string jobId,
        Action<ApiJobEvent>? progress,
        Task operationTask,
        CancellationToken cancellationToken)
    {
        /*
         * The HTTP request and status polling run concurrently.
         *
         * We stop polling when:
         *
         * 1. The HTTP request completes.
         * 2. The caller cancels.
         * 3. The job reports a terminal state.
         */

        int pollingInterval =
            DefaultPollingIntervalMs;


        while (!operationTask.IsCompleted)
        {
            cancellationToken.ThrowIfCancellationRequested();


            ApiJobStatus? status = null;


            try
            {
                status =
                    await GetJobStatusAsync(
                        jobId,
                        cancellationToken);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch
            {
                /*
                 * The status endpoint can temporarily fail while the main
                 * HTTP operation is still running.
                 *
                 * Do not fail the actual operation because of a polling
                 * failure.
                 */
            }


            if (status != null)
            {
                ApiJobEvent jobEvent =
                    CreateJobEvent(
                        status);


                progress?.Invoke(
                    jobEvent);


                if (IsTerminalStatus(status))
                {
                    /*
                     * If the server says the job failed, report it.
                     *
                     * The actual HTTP request remains authoritative for
                     * returning its response/error.
                     */
                    if (IsFailedStatus(status))
                    {
                        throw new AutoPhotoEditorApiException(
                            GetJobErrorMessage(status));
                    }


                    break;
                }
            }


            /*
             * Do not wait the full interval if the HTTP operation finishes.
             */
            try
            {
                await Task.WhenAny(
                    operationTask,
                    Task.Delay(
                        pollingInterval,
                        cancellationToken));
            }
            catch (OperationCanceledException)
            {
                throw;
            }


            /*
             * Small adaptive backoff.
             *
             * Start fast, then gradually reduce polling frequency.
             */
            pollingInterval =
                Math.Min(
                    pollingInterval + 50,
                    MaximumPollingIntervalMs);
        }
    }


    // ========================================================================
    // JOB EVENT
    // ========================================================================

    private static ApiJobEvent CreateJobEvent(
        ApiJobStatus status)
    {
        return new ApiJobEvent
        {
            JobId =
                status.JobId,

            Type =
                status.Status ?? "status",

            Stage =
                status.Stage,

            Message =
                status.Message,

            Progress =
                status.Progress,

            Final =
                IsTerminalStatus(status),

            RawJson =
                string.Empty
        };
    }


    // ========================================================================
    // TERMINAL STATUS
    // ========================================================================

    private static bool IsTerminalStatus(
        ApiJobStatus status)
    {
        string value =
            status.Status?
                .Trim()
                .ToLowerInvariant()
            ?? string.Empty;


        return value switch
        {
            "completed" => true,
            "complete" => true,
            "done" => true,
            "success" => true,
            "succeeded" => true,

            "failed" => true,
            "error" => true,

            "cancelled" => true,
            "canceled" => true,

            _ => false
        };
    }


    // ========================================================================
    // FAILED STATUS
    // ========================================================================

    private static bool IsFailedStatus(
        ApiJobStatus status)
    {
        string value =
            status.Status?
                .Trim()
                .ToLowerInvariant()
            ?? string.Empty;


        return value switch
        {
            "failed" => true,
            "error" => true,
            "cancelled" => true,
            "canceled" => true,

            _ => false
        };
    }


    // ========================================================================
    // JOB ERROR
    // ========================================================================

    private static string GetJobErrorMessage(
        ApiJobStatus status)
    {
        if (!string.IsNullOrWhiteSpace(
                status.Message))
        {
            return
                $"API job failed: {status.Message}";
        }


        return
            $"API job failed with status '{status.Status}'.";
    }


    // ========================================================================
    // CREATE JOB ID
    // ========================================================================

    private static string CreateJobId()
    {
        return Guid.NewGuid()
            .ToString("N");
    }


    // ========================================================================
    // IMAGE VALIDATION
    // ========================================================================

    private static void ValidateImagePath(
        string imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            throw new ArgumentException(
                "Image path cannot be empty.",
                nameof(imagePath));
        }


        if (!File.Exists(imagePath))
        {
            throw new FileNotFoundException(
                "Image file was not found.",
                imagePath);
        }
    }

    private static void ValidateImageBytes(byte[] imageBytes)
    {
        if (imageBytes == null || imageBytes.Length == 0)
        {
            throw new InvalidDataException(
                "The image data is empty.");
        }
    }

    public async Task<AutoEnhanceApiResult> ApplyPresetAsync(
        byte[] imageBytes,
        string preset,
        int jpegQuality = 97,
        string? jobId = null,
        Action<ApiJobEvent>? progress = null,
        CancellationToken cancellationToken = default)
    {
        ValidateImageBytes(imageBytes);

        if (string.IsNullOrWhiteSpace(preset))
        {
            throw new ArgumentException(
                "Preset cannot be empty.",
                nameof(preset));
        }

        jobId ??= CreateJobId();

        string url =
            "/apply-preset?preset=" +
            Uri.EscapeDataString(preset) +
            "&jpeg_quality=" +
            jpegQuality.ToString(CultureInfo.InvariantCulture) +
            "&job_id=" +
            Uri.EscapeDataString(jobId);

        Task<string> requestTask =
            _http.PostBytesAsync(
                url,
                imageBytes,
                "application/octet-stream",
                cancellationToken);

        string response =
            await WaitForOperationAsync(
                jobId,
                progress,
                requestTask,
                cancellationToken);

        using JsonDocument document = JsonDocument.Parse(response);
        JsonElement root = document.RootElement;

        if (!root.TryGetProperty("artifact", out JsonElement artifact) ||
            !artifact.TryGetProperty("data", out JsonElement imageData))
        {
            throw new AutoPhotoEditorApiException(
                "The API response does not contain an image artifact.");
        }

        string? base64 = imageData.GetString();
        if (string.IsNullOrWhiteSpace(base64))
        {
            throw new AutoPhotoEditorApiException(
                "The API returned an empty preset image.");
        }

        return new AutoEnhanceApiResult
        {
            JobId = jobId,
            ImageBytes = Convert.FromBase64String(base64)
        };
    }

    public async Task<AutoEnhanceApiResult> AutoEnhanceAsync(
        string imagePath,
        double strength = 1.0,
        Action<ApiJobEvent>? progress = null,
        CancellationToken cancellationToken = default)
    {
        ValidateImagePath(imagePath);

        if (strength < 0.0 || strength > 2.0)
        {
            throw new ArgumentOutOfRangeException(
                nameof(strength),
                "Strength must be between 0 and 2.");
        }


        // --------------------------------------------------------------------
        // ONE JOB ID FOR THE ENTIRE OPERATION
        // --------------------------------------------------------------------

        string jobId =
            CreateJobId();


        // --------------------------------------------------------------------
        // READ IMAGE
        // --------------------------------------------------------------------

        byte[] imageBytes =
            await File.ReadAllBytesAsync(
                imagePath,
                cancellationToken);

        if (imageBytes.Length == 0)
        {
            throw new InvalidDataException(
                "The image file is empty.");
        }


        // --------------------------------------------------------------------
        // STEP 1
        // AUTO ENHANCE DATA
        // --------------------------------------------------------------------

        string analysisUrl =
            "/auto-enhance-data" +
            "?job_id=" +
            Uri.EscapeDataString(jobId);

        Task<string> analysisTask =
            _http.PostBytesAsync(
                analysisUrl,
                imageBytes,
                "application/octet-stream",
                cancellationToken);


        // --------------------------------------------------------------------
        // POLL JOB STATUS WHILE API IS PROCESSING
        // --------------------------------------------------------------------

        Task pollingTask =
            PollJobUntilFinishedAsync(
                jobId,
                progress,
                analysisTask,
                cancellationToken);


        string analysisResponse;

        try
        {
            analysisResponse =
                await analysisTask;
        }
        finally
        {
            /*
             * We do not let polling keep the operation alive forever after
             * the HTTP operation has completed.
             *
             * The polling task will notice the completed HTTP task and stop.
             */
            try
            {
                await pollingTask;
            }
            catch (OperationCanceledException)
            {
                // Normal cancellation.
            }
        }


        cancellationToken.ThrowIfCancellationRequested();


        // --------------------------------------------------------------------
        // PARSE ANALYSIS RESPONSE
        // --------------------------------------------------------------------

        AutoEnhanceDataResult analysisResult;

        try
        {
            analysisResult =
                JsonSerializer.Deserialize<AutoEnhanceDataResult>(
                    analysisResponse,
                    JsonOptions)
                ?? throw new AutoPhotoEditorApiException(
                    "The API returned an empty analysis response.");
        }
        catch (JsonException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API returned invalid analysis JSON.",
                ex);
        }


        // --------------------------------------------------------------------
        // GET ANALYSIS JSON
        // --------------------------------------------------------------------

        JsonElement analysisElement =
            analysisResult.Analysis;

        if (analysisElement.ValueKind ==
                JsonValueKind.Undefined ||
            analysisElement.ValueKind ==
                JsonValueKind.Null)
        {
            throw new AutoPhotoEditorApiException(
                "The API did not return valid image analysis.");
        }


        // --------------------------------------------------------------------
        // STEP 2
        // AUTO ENHANCE
        // --------------------------------------------------------------------

        string imageBase64 =
            Convert.ToBase64String(imageBytes);


        var request =
            new
            {
                image_base64 = imageBase64,
                analysis = analysisElement
            };


        string requestJson =
            JsonSerializer.Serialize(request);


        string strengthString =
            strength.ToString(
                CultureInfo.InvariantCulture);


        string enhanceUrl =
            "/auto-enhance" +
            "?strength=" +
            Uri.EscapeDataString(strengthString) +
            "&job_id=" +
            Uri.EscapeDataString(jobId);


        Task<string> enhanceTask =
            _http.PostJsonAsync(
                enhanceUrl,
                request,
                cancellationToken);


        // --------------------------------------------------------------------
        // POLL ENHANCEMENT JOB
        // --------------------------------------------------------------------

        Task enhancePollingTask =
            PollJobUntilFinishedAsync(
                jobId,
                progress,
                enhanceTask,
                cancellationToken);


        string enhanceResponse;

        try
        {
            enhanceResponse =
                await enhanceTask;
        }
        finally
        {
            try
            {
                await enhancePollingTask;
            }
            catch (OperationCanceledException)
            {
                // Normal cancellation.
            }
        }


        cancellationToken.ThrowIfCancellationRequested();


        // --------------------------------------------------------------------
        // PARSE ENHANCE RESPONSE
        // --------------------------------------------------------------------

        using JsonDocument enhanceDocument =
            JsonDocument.Parse(
                enhanceResponse);

        JsonElement root =
            enhanceDocument.RootElement;


        // The API returns the image in artifact.data as base64.
        if (!root.TryGetProperty("artifact", out JsonElement artifact) ||
            !artifact.TryGetProperty("data", out JsonElement outputBase64Element))
        {
            throw new AutoPhotoEditorApiException(
                "The API response does not contain an image artifact.");
        }

        string? outputBase64 = outputBase64Element.GetString();


        if (string.IsNullOrWhiteSpace(outputBase64))
        {
            throw new AutoPhotoEditorApiException(
                "The API returned an empty enhanced image.");
        }


        byte[] outputBytes;

        try
        {
            outputBytes =
                Convert.FromBase64String(
                    outputBase64);
        }
        catch (FormatException ex)
        {
            throw new AutoPhotoEditorApiException(
                "The API returned invalid image base64 data.",
                ex);
        }


        // --------------------------------------------------------------------
        // ANALYSIS JSON
        // --------------------------------------------------------------------

        string analysisJson =
            analysisElement.GetRawText();


        // --------------------------------------------------------------------
        // RESULT
        // --------------------------------------------------------------------

        return new AutoEnhanceApiResult
        {
            JobId = jobId,
            AnalysisJson = analysisJson,
            ImageBytes = outputBytes
        };
    }



<ui:FluentWindow
    x:Class="AutoPhotoEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="AutoPhotoEditor"
    Width="1560"
    Height="980"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    Background="#0D1117">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="WindowBackground" Color="#0D1117" />
        <SolidColorBrush x:Key="Surface" Color="#151B24" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1B2430" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#233044" />
        <SolidColorBrush x:Key="Line" Color="#2A3544" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA8B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#667486" />
        <SolidColorBrush x:Key="Accent" Color="#6EA8FE" />
        <SolidColorBrush x:Key="AccentStrong" Color="#3D7EFF" />
        <SolidColorBrush x:Key="Success" Color="#64D6A2" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentStrong}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" BasedOn="{StaticResource ToolbarButton}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentStrong}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#78A8FF" />
        </Style>

        <Style x:Key="RailButton" BasedOn="{StaticResource ToolbarButton}" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#10161F" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="EditorComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#10161F" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="EditorSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111821" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentStrong}">
                        <TextBlock Text="✦" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AutoPhotoEditor" Foreground="{StaticResource TextPrimary}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="NON-DESTRUCTIVE PHOTO WORKSPACE" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#182333" CornerRadius="8" Padding="10,6" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="ORIGINAL" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="›" Foreground="{StaticResource TextMuted}" FontSize="18" VerticalAlignment="Center" Margin="4,0" />
                    <Border Background="#182333" CornerRadius="8" Padding="10,6" Margin="5,0">
                        <TextBlock Text="EDIT TIMELINE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding CheckApiHealthCommand}" Content="API STATUS" />
                    <Button Style="{StaticResource AccentButton}" Command="{Binding SaveImageCommand}" Content="Export" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="8">
                <StackPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource RailButton}" Command="{Binding ChooseImageCommand}" Content="Open" ToolTip="Open image" />
                    <Separator Background="{StaticResource Line}" Margin="5,8" />
                    <Button Style="{StaticResource RailButton}" Command="{Binding PreviousEditCommand}" Content="‹" FontSize="24" ToolTip="Previous edit" IsEnabled="{Binding CanGoPrevious}" />
                    <Button Style="{StaticResource RailButton}" Command="{Binding NextEditCommand}" Content="›" FontSize="24" ToolTip="Next edit" IsEnabled="{Binding CanGoNext}" />
                    <Separator Background="{StaticResource Line}" Margin="5,8" />
                    <Button Style="{StaticResource RailButton}" Command="{Binding ShowBeforeCommand}" Content="Before" ToolTip="Show before" />
                    <Button Style="{StaticResource RailButton}" Command="{Binding ShowAfterCommand}" Content="After" ToolTip="Show after" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="14,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Canvas" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Drag the divider to compare each incremental result with the untouched original." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#182333" CornerRadius="8" Padding="11,7">
                        <TextBlock Text="{Binding HistoryPositionText}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Panel}" Background="#090D13" Padding="2">
                    <Grid x:Name="PhotoComparisonArea" Background="#090D13" ClipToBounds="True">
                        <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                            <Image x:Name="BeforeImageControl" Source="{Binding OriginalImage}" Stretch="Fill" />
                            <Border x:Name="AfterImageClip" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" ClipToBounds="True">
                                <Image x:Name="AfterImageControl" Source="{Binding EditedImage}" Stretch="Fill" Visibility="Collapsed" />
                            </Border>
                            <Border x:Name="ComparisonDivider" Width="2" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed" />
                            <Border x:Name="ComparisonHandle" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#F2F6FF" BorderBrush="{StaticResource AccentStrong}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="↔" Foreground="{StaticResource AccentStrong}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding OriginalImage, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=PhotoComparisonArea}">
                            <TextBlock Text="Open an image to begin" Foreground="{StaticResource TextSecondary}" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Your original is always preserved." Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,18,0,0" Background="#CC111821" CornerRadius="6" Padding="8,5">
                            <TextBlock Text="BEFORE" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" Background="#CC111821" CornerRadius="6" Padding="8,5">
                            <TextBlock Text="AFTER" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="4,12,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Before" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="ComparisonSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ComparisonPosition, Mode=TwoWay}" ValueChanged="ComparisonSlider_ValueChanged" Style="{StaticResource EditorSlider}" Margin="15,0" />
                    <TextBlock Grid.Column="2" Text="After" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Adjustments" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <TextBlock Text="Build a reusable edit, one action at a time." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#192333" CornerRadius="6" Padding="7,4">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="10" MaxWidth="145" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Background="{StaticResource SurfaceRaised}" Padding="13" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Auto Enhance" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Adaptive balance for tone, color and detail." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#24406A" CornerRadius="5" Padding="6,3">
                                            <TextBlock Text="AI" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                    <DockPanel Margin="0,13,0,5">
                                        <TextBlock Text="Strength" Style="{StaticResource Caption}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AutoEnhanceStrength, StringFormat={}{0:0.0}}" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding AutoEnhanceStrength, Mode=TwoWay}" Style="{StaticResource EditorSlider}" />
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding AutoEnhanceCommand}" Content="Enhance current image" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}" Background="{StaticResource SurfaceRaised}" Padding="13" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Manual Adjust" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Fine control. Applied incrementally to the selected edit." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="PRO" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Text="Exposure" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="-2" Maximum="2" Value="{Binding ManualExposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ManualExposure, StringFormat={}{0:0.0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="1" Text="Contrast" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ManualContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ManualContrast, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="2" Text="Highlights" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ManualHighlights, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ManualHighlights, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="3" Text="Shadows" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ManualShadows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ManualShadows, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="4" Text="Temperature" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="4" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ManualTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ManualTemperature, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="5" Text="Tint" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="5" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ManualTint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding ManualTint, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="6" Text="Saturation" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="6" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ManualSaturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding ManualSaturation, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="7" Text="Sharpness" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ManualSharpness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorSlider}" />
                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding ManualSharpness, StringFormat={}{0:0}}" Foreground="{StaticResource TextPrimary}" FontSize="10" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding ManualAdjustCommand}" Content="Apply manual adjustment" Margin="0,13,0,0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <Expander Header="Mask &amp; AI tools" Foreground="{StaticResource TextPrimary}" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Masked enhancement reuses masks extracted from the untouched original." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Device" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource EditorComboBox}" Margin="12,0,0,0" SelectedValue="{Binding MaskDevice, Mode=TwoWay}" SelectedValuePath="Content">
                                            <ComboBoxItem Content="auto" /><ComboBoxItem Content="cpu" /><ComboBoxItem Content="cuda" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="Mask names (comma separated, optional)" Style="{StaticResource Caption}" Margin="0,10,0,3" />
                                    <TextBox Style="{StaticResource EditorTextBox}" Text="{Binding SelectedMaskNamesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Command="{Binding ExtractMaskDataCommand}" Content="Extract masks" Margin="0,0,4,0" />
                                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding MaskedEnhanceCommand}" Content="Enhance masks" Margin="4,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="AI denoise" Style="{StaticResource Caption}" Margin="0,13,0,3" />
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DenoiseCommand}" Content="Denoise current image" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Geometry &amp; lens" Foreground="{StaticResource TextPrimary}" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Geometry correction" Style="{StaticResource Caption}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Mode" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource EditorComboBox}" Margin="8,0,8,0" Text="{Binding GeometryMode, Mode=TwoWay}" IsEditable="True">
                                            <ComboBoxItem Content="auto" /><ComboBoxItem Content="off" /><ComboBoxItem Content="level" /><ComboBoxItem Content="vertical" /><ComboBoxItem Content="horizontal" /><ComboBoxItem Content="full" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="Rotate" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Style="{StaticResource EditorTextBox}" Text="{Binding GeometryRotate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Aspect" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Style="{StaticResource EditorTextBox}" Text="{Binding GeometryAspect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="Scale" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Style="{StaticResource EditorTextBox}" Text="{Binding GeometryScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Style="{StaticResource EditorCheckBox}" IsChecked="{Binding GeometryCrop, Mode=TwoWay}" Content="Crop valid area" />
                                        <Button Style="{StaticResource AccentButton}" Command="{Binding GeometryCorrectionCommand}" Content="Apply geometry" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <Separator Background="{StaticResource Line}" Margin="0,12,0,8" />
                                    <CheckBox Style="{StaticResource EditorCheckBox}" IsChecked="{Binding LensManual, Mode=TwoWay}" Content="Use manual lens coefficients" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="K1" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Style="{StaticResource EditorTextBox}" Text="{Binding LensK1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="K2" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBox Grid.Column="3" Style="{StaticResource EditorTextBox}" Text="{Binding LensK2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="K3" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Style="{StaticResource EditorTextBox}" Text="{Binding LensK3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="P1" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBox Grid.Column="3" Style="{StaticResource EditorTextBox}" Text="{Binding LensP1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
                                    </Grid>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding LensCorrectionCommand}" Content="Apply lens correction" Margin="0,9,0,0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Color grade &amp; pipeline" Foreground="{StaticResource TextPrimary}" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Choose a LUT preset" Style="{StaticResource Caption}" />
                                    <ComboBox Style="{StaticResource EditorComboBox}" ItemsSource="{Binding LUTs}" SelectedItem="{Binding SelectedLut, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,5,0,0" />
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ColorGradeCommand}" Content="Apply color grade" Margin="0,9,0,0" HorizontalAlignment="Stretch" />
                                    <Separator Background="{StaticResource Line}" Margin="0,12,0,8" />
                                    <TextBlock Text="Pipeline stages" Style="{StaticResource Caption}" />
                                    <TextBox Style="{StaticResource EditorTextBox}" Text="{Binding PipelineStages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding RunPipelineCommand}" Content="Run pipeline" Margin="0,9,0,0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Analysis &amp; service" Foreground="{StaticResource TextPrimary}" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Command="{Binding AnalyzeImageCommand}" Content="Analyze image" Margin="0,0,4,0" />
                                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Command="{Binding CheckApiHealthCommand}" Content="Check API" Margin="4,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#10161F" CornerRadius="9" Padding="10" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <TextBlock Text="Processing…" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding CancelProcessingCommand}" Content="Cancel" HorizontalAlignment="Right" Padding="8,4" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111821" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Timeline" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="  •  " Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock Text="{Binding HistoryPositionText}" Foreground="{StaticResource TextPrimary}" FontSize="10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PreviousEditCommand}" Content="Previous" IsEnabled="{Binding CanGoPrevious}" Padding="9,4" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ResetComparisonCommand}" Content="50 / 50" Padding="9,4" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NextEditCommand}" Content="Next" IsEnabled="{Binding CanGoNext}" Padding="9,4" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="Original preserved  •  Every action is incremental" Foreground="{StaticResource TextMuted}" FontSize="10" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
